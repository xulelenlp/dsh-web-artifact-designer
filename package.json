    "canvas-design",
    "frontend"
  ],
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xulelenlp/dsh-web-artifact-designer.git"
  },
  "homepage": "https://github.com/xulelenlp/dsh-web-artifact-designer#readme",
  "bugs": {
    "url": "https://github.com/xulelenlp/dsh-web-artifact-designer/issues"
  }
}
